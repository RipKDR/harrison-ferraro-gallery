# Copy to .env.local for local development; set the same keys in Vercel → Project → Settings → Environment Variables.

# --- Email (Resend) -----------------------------------------------------------
# API key with "Sending access" (plus "Full access" if the print waitlist segment is used).
RESEND_API_KEY=
# Sender. The ferraro.studio domain must be verified in Resend before this address can send.
ENQUIRY_FROM_EMAIL="Harrison Ferraro <hello@ferraro.studio>"
# Where enquiries and waitlist notifications are delivered (comma-separated for several).
ENQUIRY_TO_EMAIL=
# Optional: Resend segment ID for the print release waitlist. Sign-ups are always emailed to
# ENQUIRY_TO_EMAIL; with this set they are also added to the segment for a release broadcast.
RESEND_PRINT_WAITLIST_SEGMENT_ID=
# Optional: Resend segment ID for the general studio list (footer sign-up on every page). Sign-ups are
# always emailed to ENQUIRY_TO_EMAIL; with this set they are also added to the segment.
RESEND_STUDIO_LIST_SEGMENT_ID=

# --- Analytics (both optional; unset = disabled) --------------------------------
# PostHog project API key and ingestion host (US: https://us.i.posthog.com, EU: https://eu.i.posthog.com).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Vercel Web Analytics loads automatically on Vercel deployments once enabled in the dashboard.
# Set to "off" to suppress it.
NEXT_PUBLIC_VERCEL_ANALYTICS=

# --- Search engines (optional) ----------------------------------------------------
# Meta-tag verification codes; not needed if the domain is verified via DNS instead.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
