# Copy to .env.local for local development; set the same keys in Vercel → Project → Settings → Environment Variables.

# --- Email (Resend) -----------------------------------------------------------
# API key with "Sending access" (plus "Full access" if the print waitlist segment is used).
RESEND_API_KEY=
# Sender. The ferraro.studio domain must be verified in Resend before this address can send.
ENQUIRY_FROM_EMAIL="Harrison Ferraro <hello@ferraro.studio>"
# Where enquiries and waitlist notifications are delivered (comma-separated for several).
ENQUIRY_TO_EMAIL=
# Optional: Resend segment ID for the print release waitlist. Sign-ups are always emailed to
# ENQUIRY_TO_EMAIL; with this set they are also added to the segment for a release broadcast.
RESEND_PRINT_WAITLIST_SEGMENT_ID=
