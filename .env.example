# Copy to .env.local for local development; set the same keys in Vercel → Project → Settings → Environment Variables.

# --- Email (Resend) -----------------------------------------------------------
# API key with "Sending access".
RESEND_API_KEY=
# Sender. The ferraro.studio domain must be verified in Resend before this address can send.
ENQUIRY_FROM_EMAIL="Harrison Ferraro <hello@ferraro.studio>"
# Where enquiries and studio list notifications are delivered (comma-separated for several).
ENQUIRY_TO_EMAIL=
# Not read by the site: studio list sign-ups are only emailed to ENQUIRY_TO_EMAIL, because an
# unverified address must never be subscribed automatically.
RESEND_STUDIO_LIST_SEGMENT_ID=

# --- Analytics (both optional; unset = disabled) --------------------------------
# PostHog project API key and ingestion host (US: https://us.i.posthog.com, EU: https://eu.i.posthog.com).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Vercel Web Analytics loads automatically on Vercel deployments once enabled in the dashboard.
# Set to "off" to suppress it.
NEXT_PUBLIC_VERCEL_ANALYTICS=

# --- Search engines (optional) ----------------------------------------------------
# Meta-tag verification codes; not needed if the domain is verified via DNS instead.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
